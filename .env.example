# ============================ Chain / RPC ============================
CHAIN_ID=8453

# Scanner + simulation RPC. Keep this SEPARATE from ZERODEV_RPC so constant
# polling does not burn your ZeroDev credit allowance.
RPC_URL=

# ============================ Contracts ==============================
EXECUTOR_ADDRESS=

# Deploy-time only (used by script/Deploy.s.sol)
AAVE_V3_POOL=
BALANCER_VAULT=
# Must differ from each other. Admin should be cold or a multisig.
ADMIN_ADDRESS=
GUARDIAN_ADDRESS=

# ============================ Operator ===============================
# Hot key. Holds OPERATOR_ROLE only: can trigger run(), cannot withdraw.
# Treat as disposable and keep minimal gas on it.
OPERATOR_PRIVATE_KEY=

# ============================ Execution ==============================
# direct    = plain EOA tx, no bundler. Lowest latency. Use for arb.
# sponsored = ZeroDev UserOp with gas sponsorship. Use for treasury/admin.
# With EIP-7702 both routes share ONE address, so switching is free.
EXEC_MODE=direct

ZERODEV_RPC=
# UltraRelay: combined bundler+paymaster, ~30% less gas / ~20% lower latency.
# Supported on Base. Measure against direct before trusting it in the hot path.
ZERODEV_ULTRA_RELAY=false
# Keep true. When the monthly sponsorship cap is hit ZeroDev fails the UserOp,
# and without this fallback the bot stops dead mid-month.
ZERODEV_PAYMASTER_FALLBACK=true

# ============================== Risk =================================
# All values in wei / base units, integers only.

# Off-chain floor. Also pass a minProfit into every Plan so the CONTRACT
# enforces it -- off-chain checks are advisory, the contract is the guarantee.
MIN_PROFIT_WEI=1000000000000000

MAX_LOAN_WEI=100000000000000000000000

# Abort if gas cost exceeds this fraction of expected profit.
MAX_GAS_SHARE_OF_PROFIT=0.5

# Kill switch: stop after N consecutive reverts.
MAX_CONSECUTIVE_FAILURES=5

# Refuse to trade above this gas price.
MAX_FEE_PER_GAS_WEI=200000000

SCAN_INTERVAL_MS=2000

# Set to false ONLY when you are ready to spend real money.
DRY_RUN=true
